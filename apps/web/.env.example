# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Drizzle / direct Postgres) ────────────────────────────────────
DATABASE_URL=

# ─── M-Pesa / Daraja ─────────────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox                  # "sandbox" | "production"
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_STK_CALLBACK_URL=                    # Must end: /api/webhooks/mpesa/stk?token=<MPESA_WEBHOOK_SECRET>

# BUG-03 FIX: Secret token embedded in the STK callback URL.
# Generate with: openssl rand -hex 32
MPESA_WEBHOOK_SECRET=

# B2C (seller payouts)
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_SHORTCODE=
MPESA_B2C_CALLBACK_URL=                    # Must end: /api/webhooks/mpesa/b2c?token=<MPESA_B2C_WEBHOOK_SECRET>

# BUG-12 FIX: Separate secret for B2C webhook (least privilege).
# Generate with: openssl rand -hex 32
MPESA_B2C_WEBHOOK_SECRET=

# ─── Smile Identity (KYC) ────────────────────────────────────────────────────
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=                          # BUG-04 FIX: Used to verify webhook HMAC signatures
SMILE_ID_BASE_URL=https://api.smileidentity.com/v1
SMILE_ID_CALLBACK_URL=

# ─── Africa's Talking (SMS) ──────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=TrustBridge

# ─── Resend (email) ──────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
